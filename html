/* =========================
   GENERAL
========================= */

* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    font-family: Arial, sans-serif;
    color: #222;
    background: #ffffff;
    line-height: 1.6;
}


/* =========================
   NAVIGATION
========================= */

header {
    position: sticky;
    top: 0;
    z-index: 1000;
    background: #ffffff;
    border-bottom: 1px solid #eeeeee;
}

.navbar {
    max-width: 1200px;
    margin: auto;
    padding: 18px 30px;

    display: flex;
    justify-content: space-between;
    align-items: center;
}

.logo {
    font-size: 22px;
    font-weight: bold;
}

.nav-links {
    display: flex;
    gap: 25px;
}

.nav-links a {
    color: #222;
    text-decoration: none;
    font-size: 14px;
    font-weight: 600;
}


/* =========================
   HERO
========================= */

.hero {
    min-height: 85vh;

    display: flex;
    align-items: center;

    background:
        linear-gradient(
            rgba(0,0,0,0.55),
            rgba(0,0,0,0.55)
        ),
        url("images/hero.jpg");

    background-size: cover;
    background-position: center;
}

.hero-content {
    max-width: 850px;
    margin-left: 8%;
    padding: 40px;
    color: white;
}

.eyebrow {
    text-transform: uppercase;
    letter-spacing: 3px;
    font-size: 13px;
    margin-bottom: 20px;
}

.hero h1 {
    font-size: 70px;
    line-height: 1.05;
    margin-bottom: 25px;
}

.hero-text {
    max-width: 600px;
    font-size: 20px;
    margin-bottom: 35px;
}

.hero-button {
    display: inline-block;

    padding: 14px 25px;

    background: white;
    color: #222;

    text-decoration: none;
    font-weight: bold;
}


/* =========================
   GENERAL SECTIONS
========================= */

.intro,
.stories,
.gallery,
.contact {
    max-width: 1200px;
    margin: auto;
    padding: 100px 30px;
}

.section-label {
    font-size: 12px;
    letter-spacing: 3px;
    font-weight: bold;
    margin-bottom: 15px;
}

h2 {
    font-size: 42px;
    line-height: 1.2;
    margin-bottom: 25px;
}

.intro > p:last-child,
.contact > p:last-child {
    max-width: 750px;
    font-size: 18px;
}


/* =========================
   STORIES
========================= */

.story-grid {
    display: grid;

    grid-template-columns:
        repeat(3, 1fr);

    gap: 30px;
}

.story-card {
    border: 1px solid #eeeeee;
    background: white;
}

.story-image {
    height: 230px;

    display: flex;
    justify-content: center;
    align-items: center;

    background: #dddddd;
}

.story-content {
    padding: 25px;
}

.category {
    font-size: 11px;
    letter-spacing: 2px;
    font-weight: bold;
    margin-bottom: 10px;
}

.story-content h3 {
    font-size: 25px;
    margin-bottom: 12px;
}

.story-content a {
    display: inline-block;
    margin-top: 20px;

    color: #222;
    font-weight: bold;
    text-decoration: none;
}


/* =========================
   GALLERY
========================= */

.gallery {
    background: #f5f5f5;
    max-width: none;
}

.gallery h2,
.gallery .section-label {
    max-width: 1140px;
    margin-left: auto;
    margin-right: auto;
}

.gallery-grid {
    max-width: 1140px;
    margin: 40px auto 0;

    display: grid;
    grid-template-columns: repeat(2, 1fr);

    gap: 15px;
}

.gallery-item {
    height: 300px;

    display: flex;
    align-items: center;
    justify-content: center;

    background: #cccccc;
}


/* =========================
   CONTACT
========================= */

.contact {
    text-align: center;
}

.contact > p:last-child {
    margin: auto;
}


/* =========================
   FOOTER
========================= */

footer {
    padding: 40px 30px;

    text-align: center;

    background: #222;
    color: white;
}

footer p {
    margin: 5px;
}


/* =========================
   MOBILE
========================= */

@media (max-width: 768px) {

    .navbar {
        padding: 15px 20px;
    }

    .nav-links {
        gap: 12px;
    }

    .nav-links a {
        font-size: 11px;
    }

    .hero {
        min-height: 75vh;
    }

    .hero-content {
        margin-left: 0;
        padding: 30px;
    }

    .hero h1 {
        font-size: 45px;
    }

    .hero-text {
        font-size: 17px;
    }

    h2 {
        font-size: 32px;
    }

    .story-grid {
        grid-template-columns: 1fr;
    }

    .gallery-grid {
        grid-template-columns: 1fr;
    }

    .intro,
    .stories,
    .gallery,
    .contact {
        padding: 70px 20px;
    }

}